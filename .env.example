# Public Supabase project URL and anon/publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only allowlist: comma-separated email addresses allowed into /admin
ADMIN_EMAILS=

# Public business contact details are centrally configured in src/config/business.ts
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/

# Optional pricing overrides in INR; defaults live in src/config/business.ts
NEXT_PUBLIC_SINGLE_12_MONTH_PRICE=5299
NEXT_PUBLIC_SINGLE_24_MONTH_PRICE=6399
NEXT_PUBLIC_SINGLE_48_MONTH_PRICE=6999
NEXT_PUBLIC_PREMIUM_12_MONTH_PRICE=7499
NEXT_PUBLIC_PREMIUM_24_MONTH_PRICE=8999
NEXT_PUBLIC_PREMIUM_48_MONTH_PRICE=14999
NEXT_PUBLIC_SITE_URL=https://kohli-web-services.vercel.app
